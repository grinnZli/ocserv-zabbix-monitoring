# ============================================================
# .gitattributes для ocserv-zabbix-monitoring
# Нормализация окончаний строк и защита бинарных файлов
# ============================================================

# --- Автоопределение текстовых файлов ---
* text=auto eol=lf

# --- Явно текстовые файлы ---
*.md        text eol=lf
*.markdown  text eol=lf
*.txt       text eol=lf
*.rst       text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.json      text eol=lf
*.toml      text eol=lf
*.ini       text eol=lf
*.conf      text eol=lf
*.cfg       text eol=lf
*.service   text eol=lf
*.sh        text eol=lf
*.bash      text eol=lf
*.py        text eol=lf

# --- Специфика проекта: Zabbix и ocserv ---
# XML-шаблоны Zabbix (экспорт шаблонов) — текст, LF
*.xml       text eol=lf

# Скрипты мониторинга и конфиги ocserv
*.py        text eol=lf
*.pl        text eol=lf
*.php       text eol=lf
ocserv.conf text eol=lf

# SQL-скрипты (если есть инициализация БД Zabbix)
*.sql       text eol=lf

# --- Файлы, которые должны сохранять CRLF (если появятся) ---
# *.bat     text eol=crlf
# *.cmd     text eol=crlf
# *.ps1     text eol=crlf

# --- Бинарные файлы: запрет на конвертацию и diff ---
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.ico       binary
*.svg       text eol=lf
*.pdf       binary
*.zip       binary
*.gz        binary
*.tar       binary
*.tgz       binary
*.7z        binary
*.iso       binary
*.img       binary
*.bin       binary
*.exe       binary
*.dll       binary
*.so        binary
*.rpm       binary
*.deb       binary

# --- Настройки diff и merge ---
*.md diff=markdown
